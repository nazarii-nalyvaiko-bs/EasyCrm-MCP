{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nazarii-nalyvaiko-bs/easycrm-mcp",
  "description": "MCP server for managing a Shopify store and a Horoshop store",
  "repository": {
    "url": "https://github.com/nazarii-nalyvaiko-bs/EasyCrm-MCP",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "easycrm-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SHOPIFY_STORE_DOMAIN",
          "description": "Store domain, e.g. my-store.myshopify.com",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "SHOPIFY_CLIENT_ID",
          "description": "Dev Dashboard app client ID (option A, recommended)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "SHOPIFY_CLIENT_SECRET",
          "description": "Dev Dashboard app client secret (option A, recommended)",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "SHOPIFY_ADMIN_ACCESS_TOKEN",
          "description": "Permanent admin access token shpat_… (option B, instead of client credentials)",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "HOROSHOP_STORE_URL",
          "description": "Horoshop store origin, e.g. https://shop.example.com",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "HOROSHOP_LOGIN",
          "description": "Horoshop API admin login",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "HOROSHOP_PASSWORD",
          "description": "Horoshop API admin password",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
