# Configure Shopify, Horoshop, or both. Never commit real credentials.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify option A: Dev Dashboard app for stores in your own organization.
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Shopify option B: an existing admin access token. Use instead of option A.
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx

HOROSHOP_STORE_URL=https://shop.example.com
HOROSHOP_LOGIN=your_api_login
HOROSHOP_PASSWORD=your_api_password
